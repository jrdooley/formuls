diff --git a/external/abl_link_instance.cpp b/external/abl_link_instance.cpp
index c0f199a..a66b165 100644
--- a/external/abl_link_instance.cpp
+++ b/external/abl_link_instance.cpp
@@ -49,17 +49,54 @@ ableton::Link::SessionState& AblLinkWrapper::acquireAudioSessionState(
       num_peers = n;
     }
     session_state = link.captureAudioSessionState();
-    sample_time += DEFDACBLKSIZE;
-    curr_time = time_filter.sampleTimeToHostTime(sample_time) + latency_offset;
+
+    // Ask the host clock what time it is, rather than inferring it from a
+    // free-running sample counter.
+    //
+    // This used to be:
+    //     sample_time += DEFDACBLKSIZE;
+    //     curr_time = time_filter.sampleTimeToHostTime(sample_time) + ...;
+    // i.e. a linear regression mapping "how many samples have we rendered"
+    // onto host time. That is the textbook approach *provided the audio
+    // clock never skips*, because it smooths callback jitter. But sample_time
+    // is free-running and is never resynchronised, so any discontinuity --
+    // an xrun, a device dropout, the app being descheduled under load --
+    // permanently skews the mapping. curr_time then drifts away from the real
+    // clock, and since every tempo change is stamped
+    // setTempo(bpm, curr_time), Link starts placing (or rejecting) those
+    // changes at the wrong time. The audible result is a tempo that reports
+    // correctly but stops actually changing, and never recovers until the
+    // patch is reloaded.
+    //
+    // Link's own clock cannot drift from itself, so this trades a little
+    // jitter smoothing for not breaking after the first dropout.
+    curr_time = link.clock().micros() + latency_offset;
   }
   *current_time = curr_time;
   return session_state;
 }
 
 void AblLinkWrapper::releaseAudioSessionState() {
-  if (invocation_count >= shared_instance.use_count()) {
+  // Balanced against acquireAudioSessionState(): the first acquire of a DSP
+  // block captures the session state, the last matching release commits it.
+  //
+  // This used to read "if (invocation_count >= shared_instance.use_count())",
+  // i.e. it guessed how many acquires to expect from how many shared_ptrs to
+  // this wrapper existed. That assumes every living abl_link~ object ticks
+  // exactly once per block. When that does not hold -- one instance's DSP
+  // switched off, an object alive but not in the DSP graph, an extra
+  // reference held anywhere -- the count never reaches the target and
+  // commitAudioSessionState() is simply never called.
+  //
+  // The failure is silent and very confusing, because setTempo() still
+  // applies to the *captured* state, so session_state.tempo() reports the new
+  // value and the tempo outlet emits it: any GUI watching that outlet updates
+  // correctly while the actual Link timeline -- and therefore the audible
+  // tempo -- never changes.
+  //
+  // Counting acquires and releases against each other needs no such guess.
+  if (invocation_count > 0 && --invocation_count == 0) {
     link.commitAudioSessionState(session_state);
-    invocation_count = 0;
   }
 }
 
