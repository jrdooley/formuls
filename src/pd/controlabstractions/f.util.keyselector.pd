#N canvas 584 30 702 899 10;
#X text 30 20 Snaps a pitch to the nearest PITCH GAMUT pitch \, relative to the root note \, then moves it by a number of gamut steps.;
#X text 30 50 Left inlet: pitch (MIDI note \, any float). Right inlet (cold): gamut steps to move (NOTE_GEN's offset).;
#X text 30 80 The gamut (master-pitch-gamut \, pitch-gamut-length) is semitones above scale-root-note. Root F with C E F active is F A Bb. An F stays F when the root changes \, because it is still in the gamut. Checked by src/tools/quantise-probe.py.;
#X obj 30 130 inlet;
#X obj 530 130 inlet;
#X obj 30 855 outlet;
#X obj 309 194 r scale-root-note;
#X obj 553 176 r pitch-gamut-length;
#X obj 30 170 t b b f;
#X text 133 168 <- right: pitch relative to the root. middle: search the gamut. left: output;
#X obj 227 223 expr $f1 - $f2;
#X text 150 250 SEARCH: for each gamut entry \, the octave nearest the pitch: its distance \, and its gamut step (octave * L + i);
#X obj 110 280 t b b b;
#X msg 239 532 1e+09;
#X msg 125 379 0;
#X obj 110 320 f;
#X obj 110 350 until;
#X obj 110 400 f;
#X obj 150 400 + 1;
#X obj 110 430 t f f;
#X obj 110 460 tabread master-pitch-gamut;
#X obj 110 490 expr abs($f2 - $f1 - 12 * floor(($f2 - $f1) / 12 + 0.5))\\\; floor(($f2 - $f1) / 12 + 0.5) * max($f3 \, 1) + $f4;
#X obj 110 670 f;
#X obj 110 530 t f f;
#X obj 137 643 f;
#X text 250 560 <- nearer than the best so far? (first wins a tie);
#X obj 110 560 expr $f1 < $f2 - 1e-06;
#X obj 110 590 sel 1;
#X obj 110 620 t b b;
#X obj 30 660 f;
#X text 170 660 OUTPUT: step + offset -> gamut[step mod L] + 12 * floor(step / L) + root;
#X obj 30 690 +;
#X obj 30 710 t f f;
#X obj 347 761 expr 12 * floor($f1 / max($f2 \, 1));
#X obj 30 760 expr $f1 - max($f2 \, 1) * floor($f1 / max($f2 \, 1));
#X obj 30 780 tabread master-pitch-gamut;
#X obj 30 810 +;
#X obj 30 830 +;
