#N canvas 584 25 760 800 10;
#X text 20 10 Snaps a pitch to the nearest PITCH GAMUT pitch \, relative to the root note \, then moves it by a number of gamut steps.;
#X text 20 40 Left inlet: pitch (MIDI note \, any float). Right inlet (cold): gamut steps to move (NOTE_GEN's offset).;
#X text 20 70 The gamut (master-pitch-gamut \, pitch-gamut-length) is semitones above scale-root-note. Root F with C E F active is F A Bb. An F stays F when the root changes \, because it is still in the gamut. Checked by src/tools/quantise-probe.py.;
#X obj 20 120 inlet;
#X obj 520 120 inlet;
#X obj 20 760 outlet;
#X obj 400 120 r scale-root-note;
#X obj 640 120 r pitch-gamut-length;
#X obj 20 160 t b b f;
#X text 100 160 <- right: pitch relative to the root. middle: search the gamut. left: output;
#X obj 200 200 expr $f1 - $f2;
#X text 140 240 SEARCH: for each gamut entry \, the octave nearest the pitch: its distance \, and its gamut step (octave * L + i);
#X obj 100 270 t b b b;
#X msg 260 300 1e+09;
#X msg 180 300 0;
#X obj 100 330 f;
#X obj 100 360 until;
#X obj 100 390 f;
#X obj 140 390 + 1;
#X obj 100 420 t f f;
#X obj 100 450 tabread master-pitch-gamut;
#X obj 100 480 expr abs($f2 - $f1 - 12 * floor(($f2 - $f1) / 12 + 0.5))\; floor(($f2 - $f1) / 12 + 0.5) * max($f3 \, 1) + $f4;
#X obj 420 520 f;
#X obj 100 520 t f f;
#X obj 260 590 f;
#X text 240 550 <- nearer than the best so far? (first wins a tie);
#X obj 100 550 expr $f1 < $f2 - 1e-06;
#X obj 100 580 sel 1;
#X obj 100 610 t b b;
#X obj 20 650 f;
#X text 160 650 OUTPUT: step + offset -> gamut[step mod L] + 12 * floor(step / L) + root;
#X obj 20 680 +;
#X obj 20 700 t f f;
#X obj 200 720 expr 12 * floor($f1 / max($f2 \, 1));
#X obj 20 720 expr $f1 - max($f2 \, 1) * floor($f1 / max($f2 \, 1));
#X obj 20 740 tabread master-pitch-gamut;
#X obj 20 750 +;
#X obj 20 755 +;
#X connect 3 0 8 0;
#X connect 8 2 10 0;
#X connect 6 0 10 1;
#X connect 8 1 12 0;
#X connect 7 0 15 1;
#X connect 12 0 15 0;
