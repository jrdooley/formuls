declare author "James Dooley: info@formuls.co.uk";
declare copyright "James Dooley";
declare version "1.0";
declare license "MIT";
declare options "[osc:on]";

import("stdfaust.lib");
fo = library("fosc.lib"); 

// shared x^2.7 curve, used by djfilter and flooper
exp27 = pow(2.7);

//--- places all the fx below into a signal chain. This is formuls specific.
// fx = _ <: _,(am : chorus : bitcrush : saturation : filter : gate : delay) : si.interpolate(fxsend);
fx = _ <: _,(am : pitchshift : saturation : bitcrush2 : chorus : phaser : filter : gate : delay) : si.interpolate(fxsend);

fxsend = fxs
with {
  fxs = hslider("fxsend",1,0,1,0.01) : si.smoo;
};

//----------------------------------------------------------------------------------------//
//---------------------------------------FX_FUNCTIONS-------------------------------------//
//----------------------------------------------------------------------------------------//

//------AMPLITUDE_MODULATION-----//
am = _ : *(1-(amd *(amf : amosc)))
with{
  amw = hslider("amwave",0,0,1,0.001) : *(3) : si.smoo;
  amf = hslider("amfreq",0,0,1,0.001) : *(100) : max(0.01) : si.smoo;
  amd = hslider("amdepth",0,0,1,0.01) : si.smoo;
  amp = hslider("amphasereset",0.5,0,1,0.01); // phase reset

  // sine -> square -> rising sawtooth -> impulse
  amosc = _ : fo.multiwave4(amw,amp) : *(0.5) : +(0.5);
};
//-----------SATURATION---------------//
/* tanh waveshape distortion */
saturation = _ <: _,(_ : *(1.57) : ma.tanh) : si.interpolate(sat)
with{
  sat = hslider("saturation",0,0,1,0.01) : si.smoo;
};
//-----------RESONANT_FILTER---------------//
// combined resonant low and high pass filter
filter = _ : fi.resonhp(hip,hires,1) : fi.resonlp(lop,lores,1)
with {
  hip = hslider("highpass",0,0,1,0.001) : *(136) : ba.midikey2hz : si.smoo;
  hires = hslider("highpassresonance",0,0,1,0.001) : *(99) : +(1) : si.smoo;
  lop = hslider("lowpass",1,0,1,0.001) : *(136) : ba.midikey2hz : si.smoo;
  lores = hslider("lowpassresonance",0,0,1,0.001) : *(99) : +(1) : si.smoo;
};
//-----------SVF_RESONANT_FILTER---------------//
// combined resonant low and high pass filter
svffilter = _ : fi.svf_morph(freq,q,type)
with {
  type = hslider("filtertype",0,0,1,0.01) : *(2) : si.smoo; // 0 = lop; 1 = bp; 2 = hp
  freq = hslider("filterfreq",1,0,1,0.001) : *(136) : ba.midikey2hz : si.smoo;
  q = hslider("filterq",0,0,1,0.001) : *(99) : +(1) : si.smoo;
};
//-----------SIMPLEBITCRUSH---------------//
simplebitcrush = _ : ba.downSample(bit)
with {
  bit = hslider("bitcrush",0,0,1,0.01) : 1-(_) : *(47950) : +(50) : si.smoo;
};
//-----------BITCRUSH---------------//
bitcrush = _ : main
with {
  bits = 2, hslider( "bits", 16, 1, 16, 1) : pow;

  sampleFactor = hslider("downsamplingfactor",1, 1, 80, 1) : int;

  mix = hslider("mix",1, 0, 1, 0.01);

  counter(x) = int(_)~(_ <: ba.if(_<(x-1) , _+1 , 0));
  dsWet(s,c) = _~(ba.if(c == 0 , s , _));
  ds(s) = ba.if(sampleFactor > 1 , dsWet(s,counter(sampleFactor)) , s);
  depthReduction(x) = rint(x * bits) / bits;
  dryWet(m, a, b) = a * m + b * (1 - m);
  main(a) = dryWet(mix, (depthReduction(ds(a))), a);
};

//------------BITCRUSH2-------------//
bitcrush2 = _ : bitcrush
with {
  // 0 = least crushed (full ~16-bit depth), 1 = most crushed
crush   = hslider("bitcrush", 0, 0, 1, 0.001);

// Mirrors: m = 1 + (1 << ((int)((1-v)*15)))
bits_m = 1 + int(2 ^ int((1 - crush) * 15)); // --- bit-depth calculation

// --- crushing
// Mirrors: tmp = (long int)(in * m) / (float)m
// int() in Faust truncates toward zero, same as the C++ (long int) cast.
truncate(x) = float(int(x * bits_m)) / float(bits_m);

bitcrush(x) = truncate(x) ;
};

//------------PITCHSHIFT------------//
pitchshift = _ <: _,ef.transpose(1024,512,pit) : si.interpolate(mix)//
with {
  pit = hslider("pitchshift",0,-24,24,0.1) : si.smoo;
  mix = hslider("pitchshiftmix",0,0,1,0.1) : si.smoo;
};

//-------------DELAY---------------//
//interpolated delay with reverse function
delay = _ <: (_,lagrangedelay :> _),(_,reversedelay : si.interpolate(ds)) : si.interpolate(dlr)
with {
  N	= int(2^17);

  ds = hslider("delaysend",0,0,1,0.01) : si.smoo;
  dt = hslider("delaytime",0,0,1,0.01);
  df = hslider("delayfeedback",0,0,1,0.01) : si.smoo;
  dlr = checkbox("delayreverse") : int;

  dtlag = dt*(ma.SR) : si.smoo;
  dtrevpre = dt : *(5) : +(12) : int;
  dtrev = 2^(dtrevpre) : int;

  lagrangedelay = *(ds) : (+ :de.sdelay(N, 24, dtlag)) ~ *(df);
  reversedelay = _ : (+ : (ef.reverseDelayRamped(dtrev,0))) ~ *(df);
};
//-------------CHORUS-------------//
// courtesy of Albert Graef (https://github.com/brummer10/guitarix/blob/master/trunk/src/faust/chorus.dsp), simplified by formuls
chorus(x) = x+level*de.fdelay(1<<16, t, x)
with {
  depth	= hslider("chorus",0,0,1,0.01) : si.smoo;

  level	= depth +(1) : ma.log2;
  freq	= os.osc(1) : *(0.5) : +(0.25);
  dtime	= 0.02;

  t = ma.SR*dtime/2*(1+depth*tblosc(1<<16, sin, freq, 0));

  tblosc(n,f,freq,mod) = (1-d)*rdtable(n,wform,i&(n-1)) + d*rdtable(n,wform,(i+1)&(n-1))
  with {
      wform = ba.time*(2.0*ma.PI)/n : f;
      phase = freq/ma.SR : (+ : ma.decimal) ~ _;
      modphase = ma.decimal(phase+mod/(2*ma.PI))*n;
      i = int(floor(modphase));
      d = ma.decimal(modphase);
  };
};

//-------------PHASER--------------//
phaser = pf.phaser2_mono(Notches,phase,width,frqmin,fratio,frqmax,speed,depth,fb,invert)
    with{
        Notches = 4;
        phase = 0;
        width = 1000;
        frqmin = 100;
        fratio = 1.5;
        frqmax = 800;
        speed = hslider("phaserspeed",0.5,0.5,10,0.01);
        depth = hslider("phaserdepth",0,0,1,0.01);
        fb = hslider("phaserfeedback",0,-1,1,0.1);
        invert = 0;

    };
//-------------GATE---------------//
gate = _ : ef.gate_mono(gt,ga,gh,gr) : _
with {
  gt = hslider("gatethresh",0,0,1,0.01) : *(60) : -(60); //short = gt
  ga = hslider("gateattack",0.001,0,1,0.01) : *(0.25) : +(0.001); // short = ga
  gh = hslider("gatehold",0,0,1,0.01) : *(0.25) : +(0.001); // short = gh
  gr = hslider("gaterelease",0,0,1,0.01) : +(0.001); // short = gr
};
//------ENVELOPE_FOLLOWER/SIDECHAIN----//
// envelope follower with fixed fast attack (10ms)
envelopefollower = _ : max(-1) : min(1) : an.amp_follower_ar(0.01, enveloperelease) <: env, side : ba.selectn(2,envelopeside) : _
with{
  enveloperelease = hslider("enveloperelease",0.001,0.001,1,0.001) : *(0.999) : +(0.001) : si.smoo;
  envelopedepth = hslider("envelopedepth",0,0,1,0.01) : si.smoo;
  envelopeside = checkbox("envelopeside"); // 0 = envelope follow; 1  = sidechain (gain reduction)
  env = *(envelopedepth) : +(1-envelopedepth); // envelope follow algorithm
  side = 1-(_) *(envelopedepth); // sidechain algorithm
};
//------PANNING----//
panner = _ : sp.panner(pan)
with{
    pan = hslider("panning",0.5,0,1,0.01) : si.smoo;
};

//----------------------------------------//
//-------------MASTER BUS FX--------------//
//----------------------------------------//

//-------------WIDENER------------//
// code generated by Claude
widener =  crossover : (_,_,width : widener), _, _ :> _,_
with {
    width = hslider("width", 0.5, 0, 1, 0.01) : *(2) : si.smoo;
    cutoff = hslider("cutoff",1,0,1,0.01) : *(149) : +(1) : si.smoo;
    widener(l, r, w) = 
        l + side_effect(l, r, w),
        r - side_effect(l, r, w)
    with {
        side_effect(l, r, w) = (
            (l - r) * (w - 1) +                  // Stereo difference
            (l@(ma.SR/100) - r) * max(0, w - 1)  // Hass in mono
        ) * 0.5;
    };
    crossover = _,_: (fi.crossover2LR4(cutoff) : ro.cross(2)), (fi.crossover2LR4(cutoff) : ro.cross(2)) : _, ro.cross(2), _;

};

//-------------REVERB-------------//
//lush stereo reverb
rev = re.jpverb(revtime, damp, size, early_diff, 0, 1, 1, 1, 1, 500, 2000)
with {
    revtime = hslider("revtime",1,0.1,10,0.1);
    damp = hslider("damping",0,0,1,0.01) : si.smoo;
    size = hslider("size",1,0.5,3,0.1) : si.smoo;
    early_diff = hslider("diffusion",0,0,1,0.01) : si.smoo;
};

//------------LIMITER-----------//
// "Oneknob" limiter for all your bus smashing needs
limiter = monolimiter
with {
  ceiling = 0.9;
  drylevel = hslider("drylimiterlevel",1,0,1,0.01) : si.smoo;
  limlevel = hslider("limiterlevel",0,0,1,0.01) : si.smoo;

  monolimiter = _ <: (_ : @(240): *(drylevel)),(*(100) : co.limiter_lad_N(1,0.005,ceiling,0.001,0.03,0.04) : *(limlevel)) :> _;
};

//------------DJFILTER-----------//
// DJ-style oneknob filter
djfilter = djlop : djhip
with{
  fc = hslider("djfiltercutoff",0.5,0,1,0.01) : si.smoo;
  r = hslider("djfilterresonance",1,1,100,1) : si.smoo;

  fh = fc : -(0.6) : max(0) : *(2.5) : exp27 : *(5000) : +(5); // scales "filtercutoff" values between 0.6-1 to lie between 5-5000Hz (high pass)
  fl = fc : *(2.5) : min(1) : exp27 : *(9980) : +(80); // scales "filtercutoff" values between 0-0.4 to lie between 80-10060Hz (low pass)
  djhip = fi.resonhp(fh,r,1);
  djlop = fi.resonlp(fl,r,1);
};

//-------------DIGITAlISER----------//
// Creatin' dat digital sound!
digitaliser = _ <:_,(ef.transpose(300,50,amount) : ba.downSample(downsample) : bitcrusher : ef.transpose(300,50,amount*(-1))) : si.interpolate(level)
with {
amount = hslider("digitaliseramount",0,0,1,0.01) : si.smoo;
level = hslider("digitaliserlevel",0,0,1,0.01) : si.smoo;

downsample = amount : 1-(_) : pow(3) : *(47000) : +(1000);
shift = amount : *(24);
crush = amount : pow(5) : 1-(_) : *(6) : +(1.5);

bitcrusher(x) = roundf(x * scaler) / scaler;
scaler = float(2^crush - 1);
roundf(x) = floor(x + 0.5);
};

//------------REPEATER------//
// Glitchy tempo-synchronised repeater effect.
// Two delay ensembles act like "voices", ensuring audio is always present in a delay line and captured immediately after the capture button has been released
repeater = _,_ <: delayensemble(0),delayensemble(1) :> _,_ <:
    sp.stereoize(_ *(1-(mono))),
    (sp.stereoize(_ *(mono)) : + <: si.bus(2))
:> _,_
with {
  minbpm = 1;  // slider floor AND the tempo the delay lines are sized for
  tempo = hslider("bpm",120,minbpm,240,1) : 60/(_) : ba.sec2samp(_);
  divl = hslider("beatdivisionl",1,1,7,1) : int;
  divr = hslider("beatdivisionr",1,1,7,1) : int;
  capl = button("capturel");
  capr = button("capturer");
  mono = checkbox("repeatermono") : si.smoo;
  level = hslider("repeaterlevel",1,0,1,0.01) : exp27 : si.smoo;

  capcountl = +(1)~(ba.sAndH(capl : ba.impulsify)) : %(2) : int;
  capcountr = +(1)~(ba.sAndH(capr : ba.impulsify)) : %(2) : int;

  // Longest delay THIS voice can be asked for: one beat at minbpm,
  // divided by its own fixed division. Sizing every voice for the
  // smallest division instead multiplies the tables by 4; multiplying
  // by 16 (as this did) oversizes them 64x, which faust then rounds up
  // to 2^28 samples per line -- 28 GiB across the 28 lines.
  maxsamp(d) = int(ba.sec2samp(60.0 / minbpm) / d) + 1;

  delayvoice(cap, cnt, sel, i, d, x) =
      _*(x != cnt)
      : (+ : de.sdelay(maxsamp(d), 1024, float(tempo) / d))
      ~ *((x == cnt) * cap)
      : *(i == sel)
      : *(x == cnt);

  delayensemble(x) = _,_ <:
      (delayvoice(capl, capcountl, divl, 1, 4, x),
       delayvoice(capl, capcountl, divl, 2, 5, x),
       delayvoice(capl, capcountl, divl, 3, 6, x),
       delayvoice(capl, capcountl, divl, 4, 8, x),
       delayvoice(capl, capcountl, divl, 5, 10, x),
       delayvoice(capl, capcountl, divl, 6, 12, x),
       delayvoice(capl, capcountl, divl, 7, 16, x)
       :> _ : *(capl) : *(level)),
      (delayvoice(capr, capcountr, divr, 1, 4, x),
       delayvoice(capr, capcountr, divr, 2, 5, x),
       delayvoice(capr, capcountr, divr, 3, 6, x),
       delayvoice(capr, capcountr, divr, 4, 8, x),
       delayvoice(capr, capcountr, divr, 5, 10, x),
       delayvoice(capr, capcountr, divr, 6, 12, x),
       delayvoice(capr, capcountr, divr, 7, 16, x)
       :> _ : *(capr) : *(level));
};

//------------OTT----------//
// "Replica of Xfer Records OTT as a reusable stereo function (2 in, 2 out), based on the Ableton Live Multiband Dynamics 'OTT' preset it recreates."
// Code generated by Claude

ott = par(i, 2, *(inGain) : split3)   // -> Llow,Lmid,Lhigh,Rlow,Rmid,Rhigh
    : ro.interleave(3, 2)             // -> Llow,Rlow,Lmid,Rmid,Lhigh,Rhigh
    : lowB, midB, highB               // -> per-band stereo pairs
    :> par(i, 2, *(outGain))          // sum L's and R's, out gain
with {
    //------------------------------------------------------------------
    // Ableton "OTT" Multiband Dynamics preset constants
    //------------------------------------------------------------------
    fc1 = 88.3;      // low/mid crossover (Hz)
    fc2 = 2500;      // mid/high crossover (Hz)
    bandInDB = 5.2;  // per-band input gain baked into the preset (all bands)

    //------------------------------------------------------------------
    // UI (mirrors the Xfer plugin: Depth, Time, In/Out Gain, Upwd, Dnwd, band levels)
    //------------------------------------------------------------------
    main(x) = hgroup("[0]OTT", x);
    depth   = main(hslider("[0]ottdepth",    0, 0, 1, 0.001)) : si.smoo;
    timeK   = main(hslider("[1]otttime",     0.5, 0.001, 1, 0.001)) : *(2) : si.smoo;
    inGain  = main(hslider("[2]In Gain [unit:dB] [style:knob]",   0, -24, 24, 0.1)) : ba.db2linear : si.smoo;
    outGain = main(hslider("[3]Out Gain [unit:dB] [style:knob]",  0, -24, 24, 0.1)) : ba.db2linear : si.smoo;
    upwdAmt = main(hslider("[4]Upwd [unit:%] [style:knob]",     100, 0, 200, 0.1)) * 0.01 : si.smoo;
    dnwdAmt = main(hslider("[5]Dnwd [unit:%] [style:knob]",     100, 0, 200, 0.1)) * 0.01 : si.smoo;

    bands(x)  = vgroup("[1]Bands", x);
    levLowDB  = bands(vslider("[2]ottlow", 0.5, 0, 1, 0.01)) : *(48) : -(24) : si.smoo;
    levMidDB  = bands(vslider("[1]ottmid", 0.5, 0, 1, 0.01)) : *(48) : -(24) : si.smoo;
    levHighDB = bands(vslider("[0]otthigh", 0.5, 0, 1, 0.01)) : *(48) : -(24) : si.smoo;

    adv(x)  = vgroup("[2]Internals", x);
    kneeDB  = adv(hslider("[0]Knee [unit:dB]", 6, 0.1, 18, 0.1));
    upLimDB = adv(hslider("[1]Up Gain Limit [unit:dB]", 30, 0, 60, 0.1));

    meterL = bands(vbargraph("[5]GR L [unit:dB]", -40, 40));
    meterM = bands(vbargraph("[4]GR M [unit:dB]", -40, 40));
    meterH = bands(vbargraph("[3]GR H [unit:dB]", -40, 40));

    //------------------------------------------------------------------
    // 3-way Linkwitz-Riley 4th-order crossover (sums flat; low band gets an
    // allpass at fc2 so all three bands stay phase-aligned when recombined)
    //------------------------------------------------------------------
    lp(fc) = fi.lowpass(2, fc)  : fi.lowpass(2, fc);
    hp(fc) = fi.highpass(2, fc) : fi.highpass(2, fc);
    ap(fc) = _ <: lp(fc), hp(fc) :> _;

    split3 = _ <: (lp(fc1) : ap(fc2)), (hp(fc1) <: lp(fc2), hp(fc2)); // -> low, mid, high

    //------------------------------------------------------------------
    // Soft-knee gain computer helper: smooth version of max(0,x), knee width k
    //------------------------------------------------------------------
    kneePlus(k, x) = select2(x > k/2, select2(x > -k/2, 0, (x+k/2)*(x+k/2)/(2*k)), x);

    //------------------------------------------------------------------
    // One OTT band: stereo-linked RMS detector with attack/release ballistics,
    // upward + downward soft-knee compression, preset gains scaled by Depth.
    //------------------------------------------------------------------
    bandComp(atkMs, relMs, thrDn, ratioDn, thrUp, ratioUp, makeupDB, lvlKnobDB, meter, l, r)
        = l * g, r * g
    with {
        att = atkMs * 0.001 * timeK;
        rel = relMs * 0.001 * timeK;

        // linked RMS-ish envelope: attack/release ballistics on the squared peak of L/R
        env = max(l*l, r*r) : si.onePoleSwitching(att, rel) : sqrt;
        lvl = ba.linear2db(max(env, 0.000001)) + bandInDB; // -120 dB floor; +5.2 dB drives the detector too

        // downward compression above thrDn
        gDn = (1/ratioDn - 1) * kneePlus(kneeDB, lvl - thrDn);      // <= 0 dB
        // upward compression below thrUp, capped so silence isn't boosted forever
        gUp = min(upLimDB, (1 - 1/ratioUp) * kneePlus(kneeDB, thrUp - lvl)); // >= 0 dB

        // Depth scales the whole dB gain delta (comp + preset static gains):
        // depth=1 -> exact Ableton preset, depth=0 -> transparent.
        gdB = depth * (dnwdAmt*gDn + upwdAmt*gUp + bandInDB + makeupDB) + lvlKnobDB;
        g = ba.db2linear(attach(gdB, gdB : meter));
    };

    // per band: attack ms, release ms, thrDown dB, ratioDown, thrUp dB, ratioUp, makeup dB
    lowB  = bandComp(47.8, 282, -33.8, 66.7, -40.8, 4.17, 10.3, levLowDB,  meterL);
    midB  = bandComp(22.4, 282, -30.3, 66.7, -41.8, 4.17,  5.7, levMidDB,  meterM);
    highB = bandComp(13.5, 132, -35.5, 1000, -40.8, 4.17, 10.3, levHighDB, meterH);
};


//----------------------------------------------------------------------------------------//
//----------------------------------FLOOPER-----------------------------------------------//
//----------------------------------------------------------------------------------------//
//---------------flooper-------------//
flooper = _,_ : ((rwtable(floopertablesize,0.0,recindex,_,readindex) : ampenvelope : *(level) : *(play :si.smoo) : *(sampledropout)),
                        ((rwtable(floopertablesize,0.0,recindex,_,readindex) : ampenvelope : *(level) : *(play :si.smoo) : *(sampledropout))))
  with {
    //-------- paramter control interface
    record = button("record") : int;
    play = checkbox("play") : int;
    loop = checkbox("loop") : *(play) : int;
    reverse = checkbox("reverse") : int;
    level = hslider("level",0,0,1,0.01) : pow(2) : si.smoo;

    speed = hslider("speed",1,0.125,20,0.125) : si.smoo;
    duration = hslider("duration",0,0,10,1) : 2^(_);
    readoffset = hslider("readoffset",0,0,1,0.01);
    envelope = hslider("envelope",0,0,1,0.01) : 1-(_) : pow(10) : *(9999) : +(1) : si.smoo;
    dropout = hslider("dropout",0,0,1,0.01) : pow(2) : si.smoo;

    //----table record functions-----//
    floopertablesize = int(ma.SR * 80) + 2; //80 seconds of audio + 2 guard samples. 1st sample empty for readback without sound, last sample empty for write without overwriting existing sample.
    recindex = ((+(1) : %(floopertablesize)) ~ *(record)) : +(1); // records audio to tables below

    //--------calculate the recorded sample duration---//
    I = int(record);
    R = (I-I') <= 0;
    D = (+(I):*(R))~_ : +(1) : ba.sAndH(1-(record)) : si.smoo;

    //-------- Table read and envelope control-------//
    samplelength = D : *(1/(duration)) : /(speed) : int; // calculates the duration of the sample/grain in samples

    countforward = ba.countup(samplelength,play==(0)), ba.sweep(samplelength,play) : ba.selectn(2,loop); // forward playback of sample
    countbackward = ba.countdown(samplelength,play==(0)), ((<=(0) : ba.countdown(samplelength,play*(_)))~(_)) : ba.selectn(2,loop); // reverse/backward playback of sample
    countfandb = countforward,countbackward : ba.selectn(2,reverse); //aggregate of countforward and countbackward functions
    countmaster = countfandb <: *(speed : ba.sAndH(countfandb ==(0)));
    sampledropout = no.lfnoise0(32) : *(0.5) : +(0.5) : ba.sAndH(countmaster <=(1) : ba.impulsify) : >(dropout); // calculate whether a sample/grain should play or not
    readindex =  countmaster : +(readoffset *(D) : ba.sAndH(countfandb ==(0) : ba.impulsify)) : %(D) : int; //the main counter that reads from the rwtable

    // Grain/sample envelope: parabolic window applied to amplitude
    ampenvelope = _ : *(env : *(envelope) : (_,1 : min))
    with {
      phase = countmaster / (samplelength * speed);
      p = 2 * phase - 1;
      env = 1 - p * p;
    };
  };
