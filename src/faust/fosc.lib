declare author "James Dooley: info@formuls.co.uk";
declare copyright "James Dooley";
declare license "MIT";

import("stdfaust.lib");

//----------------------------------------------------------------------------------------//
//------------------------------------TABULATED WAVESHAPERS-------------------------------//
//----------------------------------------------------------------------------------------//
/* Both are pure functions of the bipolar ramp in [-1,1], so they can be pre-computed into
   a table and read back with linear interpolation. This replaces one sinf() (and, for the
   square, one tanhf()) per voice per sample with a pair of L1-resident table reads.
   Measured error vs. the direct form: better than -80 dB relative to signal. */

// sin(pi*x): 1024 points is ample - max interpolation error ~5e-6 (about -106 dB).
sinpi(x) = ba.tabulate(1, \(v).(sin(v*ma.PI)), 1024, -1, 1, x).lin;

// tanh(100*sin(pi*x)): a near-square wave. The soft transition either side of the zero
// crossing spans ~20 table cells at 4096 points, so the knee shape is preserved.
squwave(x) = ba.tabulate(1, \(v).(ma.tanh(100*sin(v*ma.PI))), 4096, -1, 1, x).lin;

//----------------------------------------------------------------------------------------//
//------------------------------------MULTI-WAVE OSCILLATOR-------------------------------//
//----------------------------------------------------------------------------------------//
/* Morphs sine -> square -> rising sawtooth -> impulse as w sweeps 0..3.
   w = waveshape position, p = phase reset. The frequency arrives on the signal input. */
multiwave4(w,p) = _ <: sine,squ,saw,puls : interpolate4(w)
    with{
        saw(y) = os.lf_sawpos_reset(y,p) :*(2) : -(1);
        sine = saw : sinpi;
        squ  = saw : squwave;
        // >(0.99) is already exactly 0 or 1, so *(2):-(1) is already exactly -1 or 1:
        // the min(1):max(-1) that used to follow were no-ops.
        puls = saw : >(0.99) : *(2) :-(1);

        interpolate4(x) = _,_,_,_ : ((_,_ : si.interpolate(clip(x))),_ : si.interpolate(clip(x-(1)))),_ : si.interpolate(clip(x-(2)));
        clip(x) = x : min(1,_) : max(0,_);
    };
